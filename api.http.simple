```http
### Admin Login
POST http://localhost:{{$dotenv APP_PORT}}/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}",
    "rememberMe": true
}

###

### Admin Register
POST http://localhost:{{$dotenv APP_PORT}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{$dotenv ADMIN_FIRSTNAME}}",
    "lastname": "{{$dotenv ADMIN_LASTNAME}}",
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}"
}

###

### Admin Forgot Password
POST http://localhost:{{$dotenv APP_PORT}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}"
}

###

### Admin Reset Password
POST http://localhost:{{$dotenv APP_PORT}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{$dotenv ADMIN_RESET_PASSWORD_TOKEN}}",
    "password": "{{$dotenv ADMIN_NEW_PASSWORD}}"
}

###

### Admin Change Password
POST http://localhost:{{$dotenv APP_PORT}}/admin/change-password
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

{
    "currentPassword": "{{$dotenv ADMIN_PASSWORD}}",
    "password": "{{$dotenv ADMIN_NEW_PASSWORD}}"
}

###

### Admin Profile
GET http://localhost:{{$dotenv APP_PORT}}/admin/users/me
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

###

### User Login
POST http://localhost:{{$dotenv APP_PORT}}/api/auth/local/
Content-Type: application/json

{
    "identifier": "{{$dotenv USER_EMAIL}}",
    "password": "{{$dotenv USER_PASSWORD}}"
}

###

### User Register
POST http://localhost:{{$dotenv APP_PORT}}/api/auth/local/register
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}",
    "username": "{{$dotenv USER_USERNAME}}",
    "password": "{{$dotenv USER_PASSWORD}}"
}

###

### User Forgot Password
POST http://localhost:{{$dotenv APP_PORT}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}"
}

###

### User Reset Password
POST http://localhost:{{$dotenv APP_PORT}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{$dotenv USER_RESET_PASSWORD_CODE}}",
    "password": "{{$dotenv USER_NEW_PASSWORD}}",
    "passwordConfirmation": "{{$dotenv USER_NEW_PASSWORD}}"
}

###

### User Change Password
POST http://localhost:{{$dotenv APP_PORT}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "currentPassword": "{{$dotenv USER_PASSWORD}}",
    "password": "{{$dotenv USER_NEW_PASSWORD}}",
    "passwordConfirmation": "{{$dotenv USER_NEW_PASSWORD}}"
}

###

### User Profile
GET http://localhost:{{$dotenv APP_PORT}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}
```
