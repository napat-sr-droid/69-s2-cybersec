# ============================================================
# ตัวอย่างไฟล์ .env (example only)
# ⚠️ ค่าด้านล่างเป็นค่าตัวอย่าง (fake) — เลียนแบบโครงสร้างไฟล์ต้นฉบับ
#    เท่านั้น ไม่ใช่ข้อมูลจริงของระบบ ห้ามใช้รันจริง
#    วิธีใช้: คัดลอกไฟล์นี้ไปเป็น .env แล้วแก้เป็นค่าจริงก่อนใช้งาน
#    (ไฟล์ .env จริงถูก gitignore ไว้ ไม่ส่งขึ้น repo)
# ============================================================

POSTGRES_PASSWORD=Example_123456
POSTGRES_USER=EXAMPLE
POSTGRES_DB=EXAMPLE_DB
POSTGRES_PORT=54321

PGADMIN_DEFAULT_PASSWORD=Example_123456
PGADMIN_DEFAULT_EMAIL=somchai@rmutp.ac.th
PGADMIN_DEFAULT_PORT=8082

DATABASE_CLIENT=postgres
DATABASE_NAME=EXAMPLE_DB
DATABASE_PORT=5432
DATABASE_HOST=db
DATABASE_USERNAME=EXAMPLE
DATABASE_PASSWORD=Example_123456

# REST Client — Admin credentials for testing
ADMIN_EMAIL=somchai@rmutp.ac.th
ADMIN_PASSWORD=Somchai_1234567890
ADMIN_FIRSTNAME=somchai
ADMIN_LASTNAME=example
ADMIN_NEW_PASSWORD=Somchai_New123456
# reset token จากอีเมลที่ระบบส่งให้ (กรอกตอนทดสอบ 1.4 Reset Password)
ADMIN_RESET_PASSWORD_TOKEN=

# REST Client — User credentials for testing
USER_EMAIL=example-user@rmutp.ac.th
USER_PASSWORD=User_123456
USER_USERNAME=example_user
USER_NEW_PASSWORD=User_New123456
# reset code จากอีเมลที่ระบบส่งให้ (กรอกตอนทดสอบ 2.4 Reset Password)
USER_RESET_PASSWORD_CODE=

APP_PORT=9092