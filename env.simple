# ============================================================
# ตัวอย่างไฟล์ .env (example only)
# ⚠️ ค่าด้านล่างเป็นค่าตัวอย่าง (fake) เท่านั้น — ห้ามใช้รันจริง
#    วิธีใช้: คัดลอกไฟล์นี้ไปเป็น .env แล้วแก้เป็นค่าจริงก่อนใช้งาน
#    (ไฟล์ .env จริงถูก gitignore ไว้ ไม่ส่งขึ้น repo)
# ============================================================

POSTGRES_PASSWORD=example_password
POSTGRES_USER=example_user
POSTGRES_DB=example_db
POSTGRES_PORT=54321

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=example_password
PGADMIN_DEFAULT_PORT=8082

DATABASE_CLIENT=postgres
DATABASE_NAME=example_db
DATABASE_PORT=5432
DATABASE_HOST=db
DATABASE_USERNAME=example_user
DATABASE_PASSWORD=example_password

# REST Client — Admin credentials for testing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin_Example123
ADMIN_FIRSTNAME=admin
ADMIN_LASTNAME=example
ADMIN_NEW_PASSWORD=Admin_Example456
# reset token จากอีเมลที่ระบบส่งให้ (กรอกตอนทดสอบ 1.4 Reset Password)
ADMIN_RESET_PASSWORD_TOKEN=example_reset_token_from_email

# REST Client — User credentials for testing
USER_EMAIL=user@example.com
USER_PASSWORD=user123456
USER_USERNAME=example_user
USER_NEW_PASSWORD=User_Example456
# reset code จากอีเมลที่ระบบส่งให้ (กรอกตอนทดสอบ 2.4 Reset Password)
USER_RESET_PASSWORD_CODE=example_reset_code_from_email

APP_PORT=9092